# Use the CUSTOM domain (required for passkeys / consistent issuer)
VITE_AUTH0_DOMAIN=yumm-pizzza.oktademo.cloud
# SPA Application Client ID from Auth0 Dashboard > Applications > <your SPA> > Settings
VITE_AUTH0_CLIENT_ID=REPLACE_WITH_SPA_CLIENT_ID
# API identifier (added in the next step, when we secure the backend)
VITE_AUTH0_AUDIENCE=
